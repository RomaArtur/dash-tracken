# Copie este arquivo para .streamlit/secrets.toml (gitignored) e
# preencha com a senha real do banco Supabase. Essa mesma string
# também deve ser colada nas Secrets do app, no Streamlit Community
# Cloud, ao publicar (App settings > Secrets).
#
# No Supabase, use o modo "Session pooler" (Project > Connect > Direct
# > Session pooler) em vez de "Direct connection": o pooler funciona em
# redes IPv4 de graça, enquanto a conexão direta usa IPv6 por padrão e
# exigiria o add-on pago de IPv4.

DATABASE_URL = "postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"
