# Copie este arquivo para .streamlit/secrets.toml (gitignored) e
# preencha com a connection string do seu banco Postgres (ex.: Neon,
# Supabase). Essa mesma string também deve ser colada nas Secrets do
# app, no Streamlit Community Cloud, ao publicar.

DATABASE_URL = "postgresql://usuario:senha@host/nome_do_banco?sslmode=require"
